# Instagram account
IG_USERNAME=your_ig_username
IG_PASSWORD=your_ig_password

# Telegram bot (@BotFather se banao)
TELEGRAM_TOKEN=123456:ABC-your-bot-token
# Apna Telegram user id (@userinfobot se milega). Sirf ye id bot ko control kar sakti hai.
TELEGRAM_OWNER_ID=123456789

# true = kuch actually send nahi hoga, sirf test. Pehle isi se test karo.
DRY_RUN=true

# warm = 3+ month purana account, roz post, real engagement
# new  = naya ya thanda account, bahut dheema chalega
ACCOUNT_MODE=warm

# Bot kitne ghante chal ke apne aap band ho jaye. 0 = jab tak aap band na karo.
# Phone par chalate ho to 3 rakho.
RUN_HOURS=3

# Follow-back on/off
FOLLOWBACK_ENABLED=true

# Story ya recent post check karke dead/bot accounts skip karo.
# false karoge to tez chalega par target quality gir jayegi.
CHECK_ACTIVITY=true

# Active window (24h format, local time)
ACTIVE_START_HOUR=11
ACTIVE_END_HOUR=22

# INFO ya WARNING. WARNING = terminal me lagbhag kuch nahi dikhega.
LOG_LEVEL=INFO
